{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.db/schemas/anydb-provider.schema.json",
  "title": "AnyDB Provider Capability Declaration",
  "description": "Machine-readable declaration of an AnyDB provider, its supported data models, operational guarantees, and conformance profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provider",
    "version",
    "models",
    "capabilities",
    "conformance"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "anydb-provider-v0.1"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,62}[a-z0-9]$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "relational",
          "document",
          "graph",
          "vector",
          "time-series",
          "event",
          "key-value",
          "object",
          "search",
          "external-service"
        ]
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalIdentity",
        "stateTransitions",
        "auditLog",
        "provenance"
      ],
      "properties": {
        "canonicalIdentity": { "type": "boolean" },
        "stateTransitions": { "type": "boolean" },
        "transactions": { "type": "boolean", "default": false },
        "temporalHistory": { "type": "boolean", "default": false },
        "changeEvents": { "type": "boolean", "default": false },
        "eventOrdering": { "type": "boolean", "default": false },
        "idempotency": { "type": "boolean", "default": false },
        "replay": { "type": "boolean", "default": false },
        "auditLog": { "type": "boolean" },
        "provenance": { "type": "boolean" },
        "policyDecisionRecords": { "type": "boolean", "default": false },
        "recordAuthorization": { "type": "boolean", "default": false },
        "evidence": { "type": "boolean", "default": false },
        "assertions": { "type": "boolean", "default": false },
        "driftDetection": { "type": "boolean", "default": false },
        "reconciliation": { "type": "boolean", "default": false },
        "fullTextSearch": { "type": "boolean", "default": false },
        "vectorSearch": { "type": "boolean", "default": false },
        "schemaValidation": { "type": "boolean", "default": false },
        "multiTenantIsolation": { "type": "boolean", "default": false }
      }
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {
          "type": "string",
          "enum": ["strong", "bounded-staleness", "eventual", "provider-defined"]
        },
        "write": {
          "type": "string",
          "enum": ["linearizable", "transactional", "atomic-record", "eventual", "provider-defined"]
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "integer" },
          { "type": "boolean" }
        ]
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openapi": { "type": "string", "format": "uri" },
        "grpc": { "type": "string", "format": "uri" },
        "events": { "type": "string", "format": "uri" },
        "docs": { "type": "string", "format": "uri" }
      }
    },
    "conformance": {
      "type": "string",
      "enum": [
        "anydb-core-v0.1",
        "anydb-event-v0.1",
        "anydb-trust-v0.1",
        "anydb-reconciled-v0.1"
      ]
    },
    "attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "issuer", "issuedAt"],
        "properties": {
          "type": { "type": "string" },
          "issuer": { "type": "string" },
          "issuedAt": { "type": "string", "format": "date-time" },
          "evidence": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
