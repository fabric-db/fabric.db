{
  "$schema": "https://fabric.db/schemas/anydb-provider.schema.json",
  "schemaVersion": "anydb-provider-v0.1",
  "provider": "surrealdb",
  "displayName": "SurrealDB",
  "version": "3.1.4",
  "models": ["document", "graph", "vector", "relational", "key-value"],
  "capabilities": {
    "canonicalIdentity": true,
    "stateTransitions": true,
    "transactions": true,
    "temporalHistory": true,
    "changeEvents": true,
    "eventOrdering": true,
    "idempotency": true,
    "replay": true,
    "auditLog": true,
    "provenance": true,
    "policyDecisionRecords": true,
    "recordAuthorization": true,
    "evidence": true,
    "assertions": true,
    "driftDetection": true,
    "reconciliation": true,
    "fullTextSearch": true,
    "vectorSearch": true,
    "schemaValidation": true,
    "multiTenantIsolation": true
  },
  "consistency": {
    "read": "provider-defined",
    "write": "transactional",
    "notes": "Fixture describes intended AnyDB adapter behavior, not a blanket claim about every SurrealDB deployment."
  },
  "endpoints": {
    "docs": "https://surrealdb.com/docs"
  },
  "conformance": "anydb-reconciled-v0.1"
}
